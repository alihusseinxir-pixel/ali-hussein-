DATABASE_URL="postgresql://basma:basma@localhost:5432/basma"
# 32+ random chars. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-change-me-change-me-change-me"
APP_URL="http://localhost:3000"
# Optional SMTP; without it invitation emails are printed to the server console.
SMTP_URL=""
MAIL_FROM="BASMA MARKETING <no-reply@basma.local>"
# --- File storage -------------------------------------------------------------
# Production: AWS S3. Setting AWS_S3_BUCKET switches storage to S3 automatically.
# NEVER commit real values. Put them in .env (git-ignored) or your host's secret manager.
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Leave the two keys empty to use an IAM role (recommended on AWS hosts).
# Uploads/downloads use presigned URLs valid for this many seconds (30–900):
PRESIGN_TTL_SECONDS="300"
MAX_UPLOAD_MB="100"

# Other S3-compatible providers (Cloudflare R2, MinIO, …): same variables above plus
#   S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   (R2: AWS_REGION="auto")
#   S3_FORCE_PATH_STYLE="true"                                  (MinIO and some self-hosted services)
#   S3_PREFIX="prod"                                            (optional folder inside the bucket)
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"
S3_PREFIX=""

# Development without AWS: files on local disk (used when AWS_S3_BUCKET is empty). Force with STORAGE_DRIVER="local" | "s3".
STORAGE_DRIVER=""
STORAGE_DIR="./uploads"

# First day of the calendar week: 0 = Sunday, 1 = Monday, 6 = Saturday
WEEK_START="0"

# Reminders: call POST /api/cron/reminders with "Authorization: Bearer $CRON_SECRET" every ~5 min (or run `npm run reminders` from system cron).
# Leave CRON_SECRET empty to disable the endpoint. Use 16+ random characters.
CRON_SECRET=""
DEADLINE_REMINDER_HOURS="24"
PUBLISH_REMINDER_HOURS="2"
