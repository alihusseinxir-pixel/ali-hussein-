# ===== الذكاء الاصطناعي (Claude) =====
# من https://console.anthropic.com → API Keys. بدونه النظام يشتغل بوضع تجريبي بسيط.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low أرخص وأسرع، high أدق

# ===== لوحة التحكم =====
# لازم تحطها قبل ما ترفع السيرفر على الإنترنت
ADMIN_PASSWORD=

# ===== Meta (واتساب + انستغرام + ماسنجر) =====
# كلمة سر تختارها انت، وتحطها نفسها بإعدادات Webhook بلوحة Meta
META_VERIFY_TOKEN=
# من App Settings → Basic → App Secret (يحمي الويبهوك من الرسائل المزورة)
META_APP_SECRET=
# توكن واتساب الدائم (System User token) من Meta Business Settings
WHATSAPP_TOKEN=
# توكن الصفحة لماسنجر/انستغرام (اختياري)
META_PAGE_TOKEN=
# META_GRAPH_VERSION=v23.0

# ===== إشعارات صاحب المحل (اختياري) =====
# اعمل بوت من @BotFather بتلغرام وحط التوكن هنا، وبعدين حط Chat ID لكل محل باللوحة
TELEGRAM_BOT_TOKEN=

# ===== عام =====
PORT=3000
BUSINESS_TIMEZONE=Asia/Baghdad
# DATA_DIR=./data
