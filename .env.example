# Copy to `.env` (git-ignored) and fill in YOUR values. Never commit `.env`.
# This file lists variable NAMES only; secrets must stay empty here.

# --- Core ---
# Example shape: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Riyadh
ALLOW_SIGNUP=true
# First day of the calendar week: 0 = Sunday, 1 = Monday, 6 = Saturday
WEEK_START=0

# --- Email (optional; without SMTP_URL, dev prints emails to the console and production sends none) ---
SMTP_URL=
MAIL_FROM=

# --- File storage: AWS S3 (see docs/STORAGE.md) ---
# Setting S3_BUCKET switches storage to S3. Leave all of these empty to use local disk in development.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave the two AWS keys empty to use an IAM role (recommended on AWS hosts). Set BOTH or NEITHER.
# Presigned upload/download links stay valid this many seconds (30–900) and the largest accepted file:
PRESIGN_TTL_SECONDS=300
MAX_UPLOAD_MB=100
# Other S3-compatible providers (Cloudflare R2, MinIO…): the same variables plus S3_ENDPOINT
# (e.g. https://<account>.r2.cloudflarestorage.com, with AWS_REGION=auto) and S3_FORCE_PATH_STYLE=true for MinIO.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_PREFIX=
# Force a driver ("local" or "s3"); normally derived from S3_BUCKET. Local-disk folder when using the local driver:
STORAGE_DRIVER=
STORAGE_DIR=./uploads

# --- Scheduled reminders (optional) ---
# POST /api/cron/reminders with "Authorization: Bearer $CRON_SECRET" every ~5 min, or run `npm run reminders` from system cron.
# Leave CRON_SECRET empty to disable the endpoint; otherwise 16+ random characters.
CRON_SECRET=
DEADLINE_REMINDER_HOURS=24
PUBLISH_REMINDER_HOURS=2
