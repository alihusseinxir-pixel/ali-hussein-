DATABASE_URL="postgresql://basma:basma@localhost:5432/basma"
# 32+ random chars. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-change-me-change-me-change-me"
APP_URL="http://localhost:3000"
# Optional SMTP; without it invitation emails are printed to the server console.
SMTP_URL=""
MAIL_FROM="BASMA MARKETING <no-reply@basma.local>"
# File storage: "local" (default, files under STORAGE_DIR) or "s3" (any S3-compatible service)
STORAGE_DRIVER="local"
STORAGE_DIR="./uploads"
MAX_UPLOAD_MB="100"
# First day of the calendar week: 0 = Sunday, 1 = Monday, 6 = Saturday
WEEK_START="0"
# Reminders: call POST /api/cron/reminders with "Authorization: Bearer $CRON_SECRET" every ~5 min (or run `npm run reminders` from system cron).
# Leave CRON_SECRET empty to disable the endpoint. Use 16+ random characters.
CRON_SECRET=""
DEADLINE_REMINDER_HOURS="24"
PUBLISH_REMINDER_HOURS="2"

# --- S3-compatible storage (only when STORAGE_DRIVER="s3") ---
# AWS S3:        S3_BUCKET, S3_REGION (credentials via keys below or an IAM role)
# Cloudflare R2: S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com", S3_REGION="auto"
# MinIO/other:   S3_ENDPOINT="http://host:9000", S3_FORCE_PATH_STYLE="true"
# Keep the bucket PRIVATE: files are served through the app, which checks permissions on every request.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PREFIX=""
